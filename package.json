{
  "name": "northframe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Sarvesh Jagtap",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets": "secretlint \"**/*\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,mts,json,css,yml}": "prettier --write",
    "*.{ts,tsx,js,mjs,mts}": "eslint --max-warnings=0",
    "*": "secretlint"
  },
  "dependencies": {
    "@dicebear/core": "9.4.3",
    "@dicebear/shapes": "9.4.2",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electric-sql/pglite": "0.5.8",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
