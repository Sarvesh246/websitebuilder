# Copy to .env.local for local development. Never commit real values.
# On Vercel, add these under Project Settings > Environment Variables (Production).
# The inquiry form (/start) stores every request in Supabase (see the Supabase block below); it
# will not accept requests until those values are set and shows a "can't be delivered right now"
# error instead of pretending to send. Resend emails are notifications on top of the stored record.

# RECOMMENDED (email notifications). Resend API key (https://resend.com > API Keys). Create it in Northframe's own Resend
# account, not a personal one. Server-only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# RECOMMENDED. Northframe inbox that receives project requests. Use a business address.
CONTACT_EMAIL=

# RECOMMENDED. Sender address, on a domain verified in Resend (for example hello@northframe.co).
# The prospect's confirmation email is also sent from here.
FROM_EMAIL=

# OPTIONAL but set before launch. Public site origin (https://your-domain, no path) for canonicals, Open Graph,
# sitemap, robots and structured data. Falls back to https://northframe.co (never localhost).
NEXT_PUBLIC_SITE_URL=

# OPTIONAL. Override the Resend API base URL. Leave unset in production. Only for local testing
# against a mock server.
RESEND_API_BASE=

# OPTIONAL (set before launch). Public business email shown in the footer, Privacy and Terms.
# Separate from CONTACT_EMAIL, which is server-only. While unset, no email is shown anywhere and
# the legal pages point to the inquiry form instead.
NEXT_PUBLIC_CONTACT_EMAIL=

# REQUIRED. Supabase project that stores every project request (table project_requests, created by
# supabase/migrations/20260928000000_project_requests.sql). URL and publishable key are public by design:
# RLS denies the table to browser roles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# REQUIRED. Server-only secret key (Supabase > Project Settings > API Keys: the "secret" sb_secret_... key,
# or the legacy service_role key). The inquiry route writes with it. NEVER prefix with NEXT_PUBLIC_,
# never commit it. Without it the form shows the "can't be delivered right now" error.
SUPABASE_SERVICE_ROLE_KEY=
